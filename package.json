{
  "name": "ruf-bulletin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "bulletin": "bun run packages/cli/src/cli.ts --store store/song-store.yaml",
    "generate": "bun run packages/cli/src/cli.ts example/example-dummy.yaml",
    "test": "bun test packages/generator/tests packages/server/tests",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun run --cwd packages/frontend build",
    "start": "bun run packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.5.4"
  }
}
